# MCP bearer tokens (required in production). Generate long random values.
MCP_PESTCONTROL_TOKEN=replace-with-long-random-pestcontrol-token
MCP_DEEPCLEANING_TOKEN=replace-with-long-random-deepcleaning-token

# Public site bases (no trailing slash)
PESTCONTROL_SITE_BASE=https://www.pestcontrol99.com
DEEPCLEANING_SITE_BASE=https://deepcleaning99.com

# Public Django API base (no trailing slash). Only AllowAny SEO-safe GETs are used.
PUBLIC_API_BASE=https://api.vacationbna.site

# Server
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Limits
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_MAX_BODY_BYTES=2000000
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_PAGE_CACHE_TTL_SECONDS=300
MCP_SITEMAP_CACHE_TTL_SECONDS=900
MCP_ROBOTS_CACHE_TTL_SECONDS=3600
MCP_BROKEN_LINK_LIMIT=25
